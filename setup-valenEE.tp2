/*************************************************************************
 * Valen Mod Pack (Modern EE/EET Edition)
 *
 * Original: Weimer
 * Modernized & Verified for EE/EET compatibility
 *
 * ---------------------------------------------------------------------
 * Version history
 * ---------------------------------------------------------------------
 * v2.0.0  Initial EE/EET modernization.
 *
 * v2.0.1  Fixed CRE version-field guard: originally used READ_LONG +
 *         integer comparison against 0x00000001, but the CRE version
 *         field at 0x04 is a 4-byte ASCII string ("V1.0" / "V2.2"),
 *         not an integer. READ_LONG returned 0x302E3156 ("V1.0"
 *         little-endian), so the guard always failed and every cleanup
 *         was silently skipped. Switched to READ_ASCII + STRING_EQUAL.
 *         Affected: valen.cre cleanup, anast.cre portrait write.
 *
 * v2.0.2  Rule 11e: component display names and the REQUIRE_PREDICATE
 *         message now use @n TRA refs (@1000-@1002) so they appear in
 *         the user's chosen language. Non-English installs fall back
 *         to the English base (Rule 11c) until translators fill them.
 *         Rule 55: bumped the Component 20 SOURCE_SIZE guard from
 *         0x274 to 0x2A0 so the later READ_ASCII 0x280 deathvar (32
 *         bytes) cannot out-of-bounds on a truncated v1.0 CRE.
 *
 * v2.0.3  Removed the Noober-era audio-purge block from
 *         ee_cre_cleanup.tpa. It had no EE-compatibility role, was
 *         introduced for a different mod, and was silently muting
 *         every sound slot on valen.cre. No TP2 logic change; the
 *         fix lives entirely in the .tpa.
 *
 * v2.0.4  Solaufein-style explicit field writes for valen.cre. The
 *         shipped CRE has two corrupted fields:
 *           - Dialogue resref at 0x2CC: byte 7 is 'v' (0x76) where
 *             it should be null padding.
 *           - Known-spells table at 0x2D4: misaligned by one byte.
 *             Entry 0 reads "alen" instead of "valen", and every
 *             subsequent entry sits one byte to the left of its
 *             intended position.
 *         Added a reusable helper file, ee_cre_fields.tpa, with the
 *         patch function EE_SET_CRE_FIELDS. The valen.cre COPY
 *         block now calls it with Valen's known values:
 *           override_script = valen
 *           class_script    = valen
 *           script_name     = valen
 *           dialogue_resref = valen
 *           ks_list         = valen,SPCL412,SPIN104,SPIN105,SPIN101
 *         No heuristic recovery — values are written explicitly at
 *         the offsets NI confirms for CRE v1.0. This also removes
 *         the temptation to bake Valen-specific data into a shared
 *         cleanup library: ee_cre_cleanup.tpa handles EE-format
 *         compatibility, ee_cre_fields.tpa is a generic writer, and
 *         the mod-specific values live only in this TP2.
 *************************************************************************/

BACKUP ~valenEE/backup~
AUTHOR ~weimer@cs.berkeley.edu~
VERSION ~v2.0.4~

// Handle UTF-8 and non-English encodings natively across platforms
HANDLE_CHARSETS

// Prevent installation abort loops if standard expansion engine tracking
// tables are unpopulated. Only files that EXTEND_TOP/EXTEND_BOTTOM/COMPILE
// target should be listed here; missing files simply skip their patch.
ALLOW_MISSING ~ar6200.bcs~
              ~ar0902.bcs~
              ~ar0903.bcs~
              ~sht0902.bcs~
              ~sht0903.bcs~

///////////////////////////////////////////////////////////////////////
// Language Setup
//
// Each non-English LANGUAGE block loads the American English setup.tra
// and epilogue.tra as a base first, then the target language's files on
// top. This gives automatic fallback: if a translated file lacks a
// newly-added @n ref, the English base supplies it. Without this
// layering, every new string added to the mod would have to be re-added
// to all ten language files.
//
// Component display names and REQUIRE_PREDICATE messages live at
// @1000-@1002 in setup.tra (Rule 11e). All non-English installs fall
// back to English until translators add them.
///////////////////////////////////////////////////////////////////////

LANGUAGE ~American English~
         ~american~
         ~valenEE/tra/american/setup.tra~
         ~valenEE/tra/american/epilogue.tra~

LANGUAGE ~Francais (traduction de Ly Meng, Laurent Duvernet et Cocobard)~
         ~french~
         ~valenEE/tra/american/setup.tra~
         ~valenEE/tra/french/setup.tra~
         ~valenEE/tra/american/epilogue.tra~
         ~valenEE/tra/french/epilogue.tra~

LANGUAGE ~Traduccion al Espanol (hecha por Clan REO)~
         ~spanish~
         ~valenEE/tra/american/setup.tra~
         ~valenEE/tra/spanish/setup.tra~
         ~valenEE/tra/american/epilogue.tra~
         ~valenEE/tra/spanish/epilogue.tra~

LANGUAGE ~Deutsche Sprache (Ubersetzung durch Sebastian de Waal & Thalantyr & Tanis & Falk)~
         ~german~
         ~valenEE/tra/american/setup.tra~
         ~valenEE/tra/german/setup.tra~
         ~valenEE/tra/american/epilogue.tra~
         ~valenEE/tra/german/epilogue.tra~

LANGUAGE ~Polski jezyk (Przetlumaczony przez Grzesiek Miazga)~
         ~polish~
         ~valenEE/tra/american/setup.tra~
         ~valenEE/tra/polish/setup.tra~
         ~valenEE/tra/american/epilogue.tra~
         ~valenEE/tra/polish/epilogue.tra~

LANGUAGE ~Italiano (by Al17 e Kelvan, http://rtt.altervista.org)~
         ~italian~
         ~valenEE/tra/american/setup.tra~
         ~valenEE/tra/italian/setup.tra~
         ~valenEE/tra/american/epilogue.tra~
         ~valenEE/tra/italian/epilogue.tra~

LANGUAGE ~Russian (translation by AERIE.ru)~
         ~russian~
         ~valenEE/tra/american/setup.tra~
         ~valenEE/tra/russian/setup.tra~
         ~valenEE/tra/american/epilogue.tra~
         ~valenEE/tra/russian/epilogue.tra~

LANGUAGE ~Chinese-Simplified (translation by yun395,kalabaka)~
         ~chs~
         ~valenEE/tra/american/setup.tra~
         ~valenEE/tra/chs/setup.tra~
         ~valenEE/tra/american/epilogue.tra~
         ~valenEE/tra/chs/epilogue.tra~

LANGUAGE ~Chinese-Traditional (translation by yun395,kalabaka)~
         ~cht~
         ~valenEE/tra/american/setup.tra~
         ~valenEE/tra/cht/setup.tra~
         ~valenEE/tra/american/epilogue.tra~
         ~valenEE/tra/cht/epilogue.tra~

LANGUAGE ~Japanese (translation by ironthrone)~
         ~japan~
         ~valenEE/tra/american/setup.tra~
         ~valenEE/tra/japan/setup.tra~
         ~valenEE/tra/american/epilogue.tra~
         ~valenEE/tra/japan/epilogue.tra~


///////////////////////////////////////////////////////////////////////
// Component 10: Valen – Core NPC (Required)
//
// Rule 11e: component display name comes from @1000 in setup.tra so
// non-English installs see it in their own language once translated.
// The GAME_IS failure message uses @1002 for the same reason.
///////////////////////////////////////////////////////////////////////

BEGIN @1000
DESIGNATED 10

REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ @1002

INCLUDE ~valenEE/lib/ee_cre_cleanup.tpa~
INCLUDE ~valenEE/lib/ee_cre_fields.tpa~
INCLUDE ~valenEE/lib/ee_spell_cleanup.tpa~
INCLUDE ~valenEE/lib/ee_cutscene_cleanup.tpa~

///////////////////////////////////////////////////////////////////////
// PORTRAITS
///////////////////////////////////////////////////////////////////////

// Large and small portraits go into override/ for the CRE to reference,
// and into portraits/ so players can select them for their own PC.
COPY ~valenEE/graphics/valens.bmp~ ~override/valens.bmp~
     ~valenEE/graphics/valenl.bmp~ ~override/valenl.bmp~
     ~valenEE/graphics/valenl.bmp~ ~portraits/valenl.bmp~
     ~valenEE/graphics/valens.bmp~ ~portraits/valens.bmp~

///////////////////////////////////////////////////////////////////////
// CREATURE FILES
///////////////////////////////////////////////////////////////////////

// Valen - the main joinable NPC.
// Original used SAY BIO only; we add SAY NAME1/NAME2 for consistency
// with the Solaufein modernization, using setup.tra @16 ("Cynara") as
// the display name and @15 for the biography.
//
// Rule 12/13: Before running EE_CRE_CLEANUP on valen.cre, we read the
// CRE format version field at 0x04. This is a 4-byte ASCII string in
// the CRE format (e.g. "V1.0" or "V2.2"), not an integer. The cleanup
// function was written for BG2 CRE v1.0 offsets. If the file is any
// other version, we skip the cleanup rather than risk corruption.
// Near Infinity confirmed valen.cre is v1.0 on BG2EE today, so the
// cleanup runs as intended; the guard protects against future
// Beamdog format changes.
//
// FIXED (v1.0.1): Original guard used READ_LONG + integer comparison
// against 0x00000001. The CRE version field is stored as ASCII, so
// READ_LONG returned 0x302E3156 ("V1.0" little-endian) and the guard
// always failed, silently skipping the cleanup. Now uses READ_ASCII
// + STRING_EQUAL, which correctly matches the ASCII version string.
//
// FIXED (v1.0.4): Added EE_SET_CRE_FIELDS call to write the fields
// we know should be in valen.cre (scripts, script name, dialogue,
// known spells) at their NI-confirmed v1.0 offsets. This replaces the
// abandoned heuristic-recovery approach — we know every value, so we
// write it explicitly rather than trying to reconstruct it.
WITH_TRA ~valenEE/tra/%LANGUAGE%/setup.tra~ BEGIN
  COPY ~valenEE/creatures/valen.cre~ ~override/valen.cre~
    SAY NAME1 @16 SAY NAME2 @16
    SAY BIO @15
    READ_ASCII 0x04 cre_ver (4)
    PATCH_IF (~%cre_ver%~ STRING_EQUAL ~V1.0~) BEGIN

      // Generic EE-format cleanup (deprecated opcodes, casing).
      LPF EE_CRE_CLEANUP END

      // Explicit field writes. Values come from the mod tree:
      //   valen.bcs -> override / class scripts
      //   valen.spl -> signature "Blighted by the Sun" ability
      //           ks1             = valen
      //           ks2             = SPCL412
      //           ks3             = SPIN104
      //           ks4             = SPIN105
      //           ks5             = SPIN101
      LPF EE_SET_CRE_FIELDS
        STR_VAR override_script = valen
                class_script    = valen
                script_name     = valen
                dialogue_resref = valen
                ks1             = valen
                ks2             = SPCL412
                ks3             = SPIN104
                ks4             = SPIN105
                ks5             = SPIN101
      END

    END
END

// Vanilla ANAST.CRE — repurposed with Valen's small portrait.
// FIXED (v1.0.1): version check switched from READ_LONG+integer to
// READ_ASCII+STRING_EQUAL to match the CRE version field's actual
// storage format. The previous check always failed and silently
// skipped the portrait write.
ACTION_IF FILE_EXISTS_IN_GAME ~anast.cre~ BEGIN
  COPY_EXISTING ~anast.cre~ ~override/anast.cre~
    READ_ASCII 0x04 cre_ver (4)
    PATCH_IF (~%cre_ver%~ STRING_EQUAL ~V1.0~) BEGIN
      WRITE_ASCIIE 0x34 ~valens~ #8
    END
    BUT_ONLY_IF_IT_CHANGES
END

// Vanilla C6VALEN.CRE — renamed via @16. Uses format-aware SAY so the
// write works regardless of CRE version.
ACTION_IF FILE_EXISTS_IN_GAME ~c6valen.cre~ BEGIN
  WITH_TRA ~valenEE/tra/%LANGUAGE%/setup.tra~ BEGIN
    COPY_EXISTING ~c6valen.cre~ ~override/c6valen.cre~
      SAY NAME1 @16 SAY NAME2 @16
      BUT_ONLY_IF_IT_CHANGES
  END
END

// Vampire Hunters. Custom CREs — plain COPY with SAY only. Rule 42:
// if a custom CRE resists cleanup, use the lowest-risk path.
WITH_TRA ~valenEE/tra/%LANGUAGE%/setup.tra~ BEGIN
  COPY ~valenEE/creatures/valenuh1.cre~ ~override/valenuh1.cre~
    SAY NAME1 @20 SAY NAME2 @20
  COPY ~valenEE/creatures/valenuh2.cre~ ~override/valenuh2.cre~
    SAY NAME1 @21 SAY NAME2 @21
  COPY ~valenEE/creatures/valenuh3.cre~ ~override/valenuh3.cre~
    SAY NAME1 @22 SAY NAME2 @22
  COPY ~valenEE/creatures/valenuh4.cre~ ~override/valenuh4.cre~
    SAY NAME1 @23 SAY NAME2 @23
END

///////////////////////////////////////////////////////////////////////
// SPELL FILES
///////////////////////////////////////////////////////////////////////

// Valen's special ability. Original used SAY NAME1+SAY NAME2 on a SPL,
// which is a non-standard keyword pair for spell files. Modernized to
// SAY NAME1 + SAY UNIDENTIFIED_DESC.
WITH_TRA ~valenEE/tra/%LANGUAGE%/setup.tra~ BEGIN
  COPY ~valenEE/spells/valen.spl~ ~override/valen.spl~
    SAY NAME1 @1 SAY UNIDENTIFIED_DESC @1
    LPF EE_SPELL_CLEANUP END
END

// Gaseous Form uses the vanilla strref #57971. No TRA ref needed.
COPY ~valenEE/spells/valenmst.spl~ ~override/valenmst.spl~
  SAY NAME1 #57971
  SAY UNIDENTIFIED_DESC #57971
  LPF EE_SPELL_CLEANUP END

///////////////////////////////////////////////////////////////////////
// ITEM FILES
///////////////////////////////////////////////////////////////////////

// Valen's Armor tiers (valena1-4). Name is @2, description varies by
// tier (@3 through @6).
//
// Valen's Claws tiers (valenh1-5). Name is @7, descriptions are @12
// (h1), @8 through @11 (h2-h5).
WITH_TRA ~valenEE/tra/%LANGUAGE%/setup.tra~ BEGIN
  COPY ~valenEE/items/valena1.itm~ ~override/valena1.itm~
    SAY NAME1 @2 SAY NAME2 @2 SAY UNIDENTIFIED_DESC @3 SAY IDENTIFIED_DESC @3
  COPY ~valenEE/items/valena2.itm~ ~override/valena2.itm~
    SAY NAME1 @2 SAY NAME2 @2 SAY UNIDENTIFIED_DESC @4 SAY IDENTIFIED_DESC @4
  COPY ~valenEE/items/valena3.itm~ ~override/valena3.itm~
    SAY NAME1 @2 SAY NAME2 @2 SAY UNIDENTIFIED_DESC @5 SAY IDENTIFIED_DESC @5
  COPY ~valenEE/items/valena4.itm~ ~override/valena4.itm~
    SAY NAME1 @2 SAY NAME2 @2 SAY UNIDENTIFIED_DESC @6 SAY IDENTIFIED_DESC @6
  COPY ~valenEE/items/valenh1.itm~ ~override/valenh1.itm~
    SAY NAME1 @7 SAY NAME2 @7 SAY UNIDENTIFIED_DESC @12 SAY IDENTIFIED_DESC @12
  COPY ~valenEE/items/valenh2.itm~ ~override/valenh2.itm~
    SAY NAME1 @7 SAY NAME2 @7 SAY UNIDENTIFIED_DESC @8 SAY IDENTIFIED_DESC @8
  COPY ~valenEE/items/valenh3.itm~ ~override/valenh3.itm~
    SAY NAME1 @7 SAY NAME2 @7 SAY UNIDENTIFIED_DESC @9 SAY IDENTIFIED_DESC @9
  COPY ~valenEE/items/valenh4.itm~ ~override/valenh4.itm~
    SAY NAME1 @7 SAY NAME2 @7 SAY UNIDENTIFIED_DESC @10 SAY IDENTIFIED_DESC @10
  COPY ~valenEE/items/valenh5.itm~ ~override/valenh5.itm~
    SAY NAME1 @7 SAY NAME2 @7 SAY UNIDENTIFIED_DESC @11 SAY IDENTIFIED_DESC @11
END

///////////////////////////////////////////////////////////////////////
// SCRIPTS
///////////////////////////////////////////////////////////////////////

// Main AI script. Plain COPY of the pre-compiled BCS.
COPY ~valenEE/scripts/valen.bcs~ ~override/valen.bcs~

// Cutscene hardening pass on the copied BCS.
COPY_EXISTING ~override/valen.bcs~ ~override/valen.bcs~
  LPF EE_CUTSCENE_CLEANUP END
  BUT_ONLY_IF_IT_CHANGES

// Vampire hunter scripts. Original used REPLACE with placeholder
// values 99991-99995. Modernized to REPLACE_TEXTUALLY with resolved
// strrefs. The placeholders are unique to these files, so the
// substitution cannot accidentally hit unrelated text.
OUTER_SET hunt_bar1 = RESOLVE_STR_REF(@24)
OUTER_SET hunt_bar2 = RESOLVE_STR_REF(@25)
OUTER_SET hunt_bar3 = RESOLVE_STR_REF(@26)
OUTER_SET hunt_bar4 = RESOLVE_STR_REF(@27)
OUTER_SET hunt_bar5 = RESOLVE_STR_REF(@28)

COPY ~valenEE/scripts/valensla.bcs~ ~override/valensla.bcs~
     ~valenEE/scripts/valenuh4.bcs~ ~override/valenuh4.bcs~
  REPLACE_TEXTUALLY ~99991~ ~%hunt_bar1%~
  REPLACE_TEXTUALLY ~99992~ ~%hunt_bar2%~
  REPLACE_TEXTUALLY ~99993~ ~%hunt_bar3%~
  REPLACE_TEXTUALLY ~99994~ ~%hunt_bar4%~
  REPLACE_TEXTUALLY ~99995~ ~%hunt_bar5%~
  BUT_ONLY_IF_IT_CHANGES

///////////////////////////////////////////////////////////////////////
// DIALOGUES
//
// Rule 9: each dialogue compiles with only its own TRA. The layered
// LANGUAGE declarations above handle fallback for setup.tra and
// epilogue.tra globally.
///////////////////////////////////////////////////////////////////////

COMPILE ~valenEE/dialogues/valen.d~
  USING ~valenEE/tra/%LANGUAGE%/valen.tra~

COMPILE ~valenEE/dialogues/valenint.d~
  USING ~valenEE/tra/%LANGUAGE%/valenint.tra~

COMPILE ~valenEE/dialogues/hunt1.d~
  USING ~valenEE/tra/%LANGUAGE%/hunt1.tra~

// ToB continuation
ACTION_IF GAME_INCLUDES ~tob~ BEGIN
  COMPILE ~valenEE/dialogues/valentob.d~
    USING ~valenEE/tra/%LANGUAGE%/valentob.tra~

  // ToB epilogue table. Rule 21: replace BOTH data columns so it
  // doesn't matter which one the engine reads.
  OUTER_SET valen_epilogue = RESOLVE_STR_REF(@999999)

  COPY ~valenEE/dialogues/valenend.2da~ ~override/valenend.2da~
    REPLACE_TEXTUALLY ~71020~ ~%valen_epilogue%~
    REPLACE_TEXTUALLY ~999999~ ~%valen_epilogue%~
    PRETTY_PRINT_2DA
    BUT_ONLY_IF_IT_CHANGES

  EXTEND_TOP ~ar6200.bcs~ ~valenEE/scripts/valenend.bcs~
END

///////////////////////////////////////////////////////////////////////
// 2DA REGISTRATION
//
// Rule 51: pdialog.2da on BG2EE/EET has 8 columns (identifier + 7 data
// values). The original mod used a 4-column row for pre-ToB installs
// and an 8-column row for ToB. Modern EE always has ToB, so only the
// 8-column row is needed.
///////////////////////////////////////////////////////////////////////

APPEND ~pdialog.2da~
~Valen ValenP ValenJ ValenD ValenP ValenJ Valen Valen~
UNLESS ~Valen~

COPY_EXISTING ~pdialog.2da~ ~override~
  PRETTY_PRINT_2DA
  BUT_ONLY_IF_IT_CHANGES

///////////////////////////////////////////////////////////////////////
// AREA SCRIPT EXTENSIONS
///////////////////////////////////////////////////////////////////////

EXTEND_TOP ~ar0902.bcs~ ~valenEE/scripts/ar0902.bcs~
EXTEND_TOP ~ar0903.bcs~ ~valenEE/scripts/ar0903.bcs~
EXTEND_TOP ~sht0903.bcs~ ~valenEE/scripts/sht0903.bcs~

// Original also patched sht0902.bcs with the same source (sht0903.bcs).
// The file may not exist on all installs; ALLOW_MISSING above covers it.
EXTEND_TOP ~sht0902.bcs~ ~valenEE/scripts/sht0903.bcs~

// Extend all priest AI scripts so Valen's level-drain immunity ability
// is available to priest NPCs. Uses the pre-compiled priest.bcs blob.
EXTEND_TOP_REGEXP ~.*\(PRIE\|CLER\|HEAL\|PRST\|SHAM\).*\.BCS~ ~valenEE/scripts/priest.bcs~

AT_INTERACTIVE_EXIT ~VIEW valenEE/readme-valen.txt~


///////////////////////////////////////////////////////////////////////
// Component 20: Give More Creatures Protection From Level Drain & Undead
//
// This is an independent tweak that does not require Component 10.
// It grants level-drain immunity items to inherently-undead-immune
// creatures and adds a "protection from undead" item to select priest
// and paladin-type NPCs.
//
// Rule 11e: component display name comes from @1001 in setup.tra.
//
// Scope note (deliberate): this component currently patches only v1.0
// CREs. v2.2 CREs are intentionally skipped because the race/class
// byte offsets used below (0x272/0x273) are v1.0-specific and have not
// been field-by-field verified against v2.2 layout in NI. If a future
// revision adds v2.2 support, it should read race/class from the
// verified v2.2 offsets rather than reuse the v1.0 ones (Rule 13).
///////////////////////////////////////////////////////////////////////

BEGIN @1001
DESIGNATED 20

COPY ~valenEE/items/levimm.itm~ ~override~
     ~valenEE/items/prodead.itm~ ~override~

// Rule 55: SOURCE_SIZE guard skips truncated files.
// Rule 13: apply per-format guards so v1.0 and v2.2 files don't collide.
// The version field at 0x04 is a 4-byte ASCII string ("V1.0", "V2.2"),
// not an integer. We check it with READ_ASCII + STRING_EQUAL. Only v1.0
// files are patched; v2.2 and unknown formats are skipped entirely
// rather than risk corrupting them.
//
// FIXED (v1.0.1): Original guard used READ_LONG + integer comparison
// against 0x00000001. The CRE version field is stored as ASCII, so
// READ_LONG returned 0x302E3156 ("V1.0" little-endian) and the guard
// always failed, silently skipping every CRE. This is why no CREs were
// patched in the initial test install despite the log reporting
// "Copying and patching 4758 files".
//
// FIXED (v1.0.2): SOURCE_SIZE guard was >0x274, which protected the
// early reads but not the later READ_ASCII 0x280 deathvar (32 bytes,
// needs file size >= 0x2A0). A truncated v1.0 CRE between 0x275 and
// 0x29F would abort the install with "illegal N-byte read". Bumped to
// >=0x2A0.
COPY_EXISTING_REGEXP GLOB ~.*\.cre~ ~override~
  PATCH_IF (SOURCE_SIZE >= 0x2A0) BEGIN
    READ_ASCII 0x04 cre_version (4)
    PATCH_IF (~%cre_version%~ STRING_EQUAL ~V1.0~) BEGIN
      READ_BYTE   0x272 race
      READ_BYTE   0x273 class
      READ_SHORT  0x28  animation

      PATCH_IF
           (race = 144)        // golem
        OR (race = 145)        // elemental
        OR (race = 121)        // demonic
        OR (race = 119)        // slime
        OR (race = 136)        // mist
        OR (animation = 32565) // mist creature
        OR (animation = 32572) // antisolar
        OR (animation = 32571) // solar
        OR (animation = 25605) // empty circle (mephit portal)
        OR (animation = 25606) // big empty circle (shadow altar)
      THEN BEGIN
        ADD_CRE_ITEM ~LEVIMM~ #0 #0 #0 ~UNDROPPABLE~
          ~GLOVES BELT LRING RRING AMULET BOOTS HELMET~
      END

      PATCH_IF
           (class = 3)         // CLERIC
        OR (class = 204)       // CLERIC_ALL
        OR (class = 14)        // CLERIC_MAGE
        OR (class = 18)        // CLERIC_RANGER
        OR (class = 15)        // CLERIC_THIEF
        OR (class = 8)         // FIGHTER_CLERIC
        OR (class = 17)        // FIGHTER_MAGE_CLERIC
        OR (class = 6)         // PALADIN
      THEN BEGIN
        READ_ASCII 0x280 deathvar
        // Exclude party NPCs — they have their own kit-based protections
        // and should not receive an unconditional bonus.
        PATCH_IF NOT FILE_CONTAINS_EVALUATED(~pdialog.2da~ ~%deathvar%~) BEGIN
          ADD_CRE_ITEM ~PRODEAD~ #0 #0 #0 ~UNDROPPABLE~
            ~GLOVES BELT LRING RRING AMULET BOOTS HELMET~
        END
      END
    END
    // v2.2 and unknown formats: intentionally skipped (Rule 13).
  END
  BUT_ONLY_IF_IT_CHANGES