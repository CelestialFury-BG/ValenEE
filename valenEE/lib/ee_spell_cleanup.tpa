//////////////////////////////////////////////////////////////
// EE_SPELL_CLEANUP — Modern SPL Auto‑Patcher for EE/EET    //
//////////////////////////////////////////////////////////////

DEFINE_PATCH_FUNCTION EE_SPELL_CLEANUP BEGIN

  //////////////////////////////////////////////////////////
  // 1. Remove Deprecated or Broken Opcodes Safely
  //////////////////////////////////////////////////////////
  LPF DELETE_EFFECT INT_VAR match_opcode = 12  END // old portrait icon
  LPF DELETE_EFFECT INT_VAR match_opcode = 142 END // removed effect
  LPF DELETE_EFFECT INT_VAR match_opcode = 215 END // removed proficiency effect
  LPF DELETE_EFFECT INT_VAR match_opcode = 248 END // removed engine effect
  LPF DELETE_EFFECT INT_VAR match_opcode = 267 END // removed engine effect

  //////////////////////////////////////////////////////////
  // 2. Sanitize Spell Schools & Secondary Types (Root Header)
  //////////////////////////////////////////////////////////
  READ_BYTE 0x1c school
  PATCH_IF (school > 9) BEGIN
    WRITE_BYTE 0x1c 0 // Reset to generalist if corrupt
  END

  READ_BYTE 0x1d sec_type
  PATCH_IF (sec_type > 9) BEGIN
    WRITE_BYTE 0x1d 0 // Reset if corrupt
  END

  //////////////////////////////////////////////////////////
  // 3. Fix Projectiles & Saving Throws inside Extended Headers
  //////////////////////////////////////////////////////////
  GET_OFFSET_ARRAY headers SPL_V10_HEADERS
  PHP_EACH headers AS int => r_offset BEGIN
    // Read the projectile assigned to this spell ability head
    READ_SHORT (r_offset + 0x26) proj
    PATCH_IF (proj = 0 OR proj = 255) BEGIN
      WRITE_SHORT (r_offset + 0x26) 1 // Force safe default projectile
    END
  END

END