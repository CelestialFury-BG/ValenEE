//////////////////////////////////////////////////////////////
// EE_CUTSCENE_CLEANUP — EE/EET cutscene hardening function  //
//////////////////////////////////////////////////////////////

DEFINE_PATCH_FUNCTION EE_CUTSCENE_CLEANUP BEGIN

  // Only operate on compiled script blocks safely
  DECOMPILE_AND_PATCH BEGIN

    // Safe Replacement: only adds Wait(1) if it isn't already present right after.
    // The trailing %LNL% preserves line separation after consuming whitespace.
    REPLACE_TEXTUALLY ~StartCutSceneMode()[%TAB% %LNL%]*\(Wait([0-9]+)\)?~
                      ~StartCutSceneMode() Wait(1)%LNL%~

    // Normalize capitalization structure for Player1 scripting checks
    REPLACE_TEXTUALLY ~[Cc][Uu][Tt][Ss][Cc][Ee][Nn][Ee][Ii][Dd]([Pp][Ll][Aa][Yy][Ee][Rr]1)~
                      ~CutSceneId(Player1)~

  END

END

//////////////////////////////////////////////////////////////
// EE_CUTSCENE_ONESHOT_GUARD — prevent re‑firing            //
//////////////////////////////////////////////////////////////

DEFINE_PATCH_FUNCTION EE_CUTSCENE_ONESHOT_GUARD
  INT_VAR guard_type = 1
  STR_VAR global_name = ~~
BEGIN

  PATCH_IF (NOT ~%global_name%~ STRING_EQUAL ~~) BEGIN
    DECOMPILE_AND_PATCH BEGIN
      // Safe, escaped regex evaluation tracking targeting global state variables
      REPLACE_TEXTUALLY ~IF[ %TAB%%LNL%]+Global(\"%global_name%\",\"GLOBAL\",1)~
                        ~IF Global("%global_name%","GLOBAL",0)~
    END
  END

END